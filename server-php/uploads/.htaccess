# User-uploaded content directory — never execute anything here, only serve
# static files. Defense-in-depth on top of the server-side extension
# whitelist in index.php's /api/upload handler.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php[0-9]|pl|py|cgi|asp|aspx|sh|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
