<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Allow-lists third-party assets actually used by this app (Google Fonts, the
  # Puter AI SDK loaded in index.html) instead of leaving script-src wide open.
  # If a future third-party integration breaks, check the browser console for
  # the specific CSP violation and extend the matching directive below.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.puter.com https://*.puter.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://tilmide.ma https://*.puter.com; frame-src https://*.puter.com; object-src 'none'; base-uri 'self'"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Block access to specific WordPress paths with a 404
  RewriteRule ^wp-admin - [R=404,L]
  RewriteRule ^wp-content - [R=404,L]
  RewriteRule ^wp-includes - [R=404,L]
  # Block date-based archives (e.g., /2025/08/)
  RewriteRule ^[0-9]{4}/[0-9]{2}/ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
