PORT=5000
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=tilmid_db
JWT_SECRET=
# Required, at least 32 characters. Generate with: node -p "require('crypto').randomBytes(32).toString('hex')"
ALLOWED_ORIGINS=https://tilmide.ma,https://www.tilmide.ma
# Set to 1 when the API sits behind a reverse proxy (cPanel/Passenger, Apache, nginx) so the
# login rate limit sees real client IPs. Leave empty when clients connect to Node directly.
TRUST_PROXY=

# Required only while provisioning the first administrator.
ADMIN_EMAIL=
ADMIN_USERNAME=Admin User
ADMIN_BOOTSTRAP_PASSWORD=
